/*
 * The tab bar itself: fixed to the bottom, one entry per visible tab, active state marked by
 * colour plus a small bar above the label.
 *
 * No icons and no images: a four-entry Chinese label bar reads fine at this size, and shipping
 * PNGs would mean binary assets in a client whose whole point is having none. The active marker is
 * a shape rather than an emoji, and the label is always present - a group of glyph-only buttons
 * would be unusable for a 一年级 pupil.
 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-top: 1rpx solid #E9E1D3;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 14rpx;
  color: #6E7D91;
}

.tabbar__mark {
  width: 36rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: transparent;
  margin-bottom: 10rpx;
}

.tabbar__text {
  font-size: 24rpx;
  line-height: 1;
}

.tabbar__item.is-active {
  color: #17583E;
}

.tabbar__item.is-active .tabbar__mark {
  background: #17583E;
}

.tabbar--teacher .tabbar__item.is-active {
  color: #1C5C87;
}

.tabbar--teacher .tabbar__item.is-active .tabbar__mark {
  background: #1C5C87;
}
