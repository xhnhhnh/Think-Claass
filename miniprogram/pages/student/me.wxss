.error-card {
  border-left: 8rpx solid #DE3B35;
}

/* ------------------------------------------------------------------ profile */

.profile {
  padding: 32rpx;
}

.profile__avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: #17583E;
  color: #FFFFFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  text-align: center;
  line-height: 1.2;
}

.profile__name {
  font-size: 36rpx;
  font-weight: 600;
}

/* ------------------------------------------------------------------ certificates */

.cert {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.cert:last-child {
  border-bottom: none;
}

.cert__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #17583E;
}

.cert__desc {
  font-size: 25rpx;
  color: #6E7D91;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ------------------------------------------------------------------ form */

.form {
  padding: 8rpx 0 16rpx;
}

.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.field--last {
  border-bottom: none;
}

.field__label {
  font-size: 24rpx;
  color: #6E7D91;
  margin-bottom: 8rpx;
}

.field__input {
  width: 100%;
  height: 60rpx;
  font-size: 30rpx;
}

.field__placeholder {
  color: #B3ADA0;
  font-size: 27rpx;
}

.foot {
  text-align: center;
  padding: 32rpx 0 8rpx;
}
