.hero {
  padding: 40rpx 32rpx;
}

.hero__greeting {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.hero__date {
  font-size: 24rpx;
  color: #B9D6C6;
  margin-top: 6rpx;
}

.hero__level {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero__level-name {
  font-size: 32rpx;
  color: #FFFFFF;
}

.hero__credits {
  font-size: 24rpx;
  color: #B9D6C6;
}

.error-card {
  border-left: 8rpx solid #DE3B35;
}

.announce {
  border-left: 8rpx solid #2191C4;
}

.announce__body {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #404F64;
  line-height: 1.6;
}

/* ---------------------------------------------------------------- dimensions */

.dim {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.dim--last {
  border-bottom: none;
  padding-bottom: 0;
}

.dim__name {
  font-size: 27rpx;
  color: #404F64;
}

.dim__value {
  font-size: 27rpx;
  color: #17583E;
  font-weight: 600;
}

.dim .bar {
  margin-top: 12rpx;
}

.bar__fill {
  transition: width 0.4s ease;
}

/* ---------------------------------------------------------------- homework */

.todo {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.todo:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.todo__title {
  font-size: 29rpx;
  color: #0F1729;
}

.todo__due {
  font-size: 24rpx;
  margin-top: 6rpx;
  color: #6E7D91;
}

.due--warning {
  color: #D8790E;
}

.due--danger {
  color: #DE3B35;
}

/* ---------------------------------------------------------------- quick entries */

.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.quick__item {
  flex: 1 1 40%;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  border-radius: 18rpx;
  background: #FBFAF6;
  border: 1rpx solid #E9E1D3;
}

.quick__dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 8rpx;
}

.quick__dot--brand {
  background: #17583E;
}

.quick__dot--info {
  background: #2191C4;
}

.quick__dot--warn {
  background: #D8790E;
}

.quick__dot--success {
  background: #307E50;
}

.quick__label {
  font-size: 28rpx;
  color: #0F1729;
}
