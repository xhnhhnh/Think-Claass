.error-card {
  border-left: 8rpx solid #DE3B35;
}

/* ------------------------------------------------------------------ balance */

.balance {
  background: #17583E;
  border-color: #17583E;
}

.balance__label {
  font-size: 24rpx;
  color: #B9D6C6;
}

.balance__value {
  font-size: 60rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.2;
}

.balance__hint {
  max-width: 300rpx;
  font-size: 23rpx;
  color: #B9D6C6;
  text-align: right;
  line-height: 1.5;
}

/* ------------------------------------------------------------------ switch */

.switch {
  display: flex;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  background: #F1EFE7;
}

.switch__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: #6E7D91;
  border-radius: 999rpx;
}

.switch__item.is-active {
  background: #FFFFFF;
  color: #17583E;
  font-weight: 600;
}

/* ------------------------------------------------------------------ item */

.item {
  padding: 28rpx;
}

.item__name {
  font-size: 32rpx;
  font-weight: 600;
}

.item__desc {
  font-size: 25rpx;
  color: #6E7D91;
  margin-top: 8rpx;
  line-height: 1.5;
}

.item__price {
  text-align: right;
  margin-left: 20rpx;
  min-width: 120rpx;
}

.item__price-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #D8790E;
  line-height: 1.1;
}

.item__price-unit {
  font-size: 22rpx;
  color: #6E7D91;
}

/* ------------------------------------------------------------------ tickets */

.ticket {
  padding: 28rpx;
  border-left: 8rpx solid #307E50;
}

.ticket__name {
  font-size: 30rpx;
  font-weight: 600;
}

.ticket__code {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #FBFAF6;
  border: 2rpx dashed #E9E1D3;
  font-size: 40rpx;
  letter-spacing: 6rpx;
  text-align: center;
  color: #17583E;
  font-weight: 600;
}
