.page--footbar {
  padding-bottom: 260rpx;
}

.error-card {
  border-left: 8rpx solid #DE3B35;
}

/* ------------------------------------------------------------------ header */

.head {
  padding: 32rpx;
}

.head__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.head__badge {
  font-size: 22rpx;
  color: #B9D6C6;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.head__sub {
  font-size: 25rpx;
  color: #B9D6C6;
  margin-top: 12rpx;
}

.head__ai {
  font-size: 24rpx;
  color: #8FBBA3;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ------------------------------------------------------------------ result */

.result {
  border-left: 8rpx solid #307E50;
}

.result__title {
  font-size: 30rpx;
  font-weight: 600;
}

.result__summary {
  font-size: 32rpx;
  color: #17583E;
  font-weight: 600;
  margin-top: 12rpx;
}

/* ------------------------------------------------------------------ item */

.item {
  padding: 28rpx;
}

.item__no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #2191C4;
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item__reason {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #E2F1F8;
  color: #176D93;
  font-size: 25rpx;
  line-height: 1.55;
}

.item__stem {
  margin-top: 20rpx;
  font-size: 31rpx;
  line-height: 1.6;
}

.option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E9E1D3;
  background: #FBFAF6;
}

.option--selected {
  border-color: #17583E;
  background: #E4F0E9;
}

.option__mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E9E1D3;
  color: #6E7D91;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option--selected .option__mark {
  background: #17583E;
  border-color: #17583E;
  color: #FFFFFF;
}

.option__text {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.5;
}

.answer {
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E9E1D3;
  background: #FBFAF6;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.answer-placeholder {
  color: #B3ADA0;
  font-size: 28rpx;
}

.judge {
  margin-top: 20rpx;
}

/* ------------------------------------------------------------------ footer */

.footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #FFFFFF;
  border-top: 1rpx solid #E9E1D3;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.footbar__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 14rpx;
}

.footbar__save {
  flex: 1;
}

.footbar__submit {
  flex: 2;
}
