.login {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 64rpx 40rpx 40rpx;
}

.login__brand {
  text-align: center;
  padding: 40rpx 0 56rpx;
}

.login__logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 40rpx;
  background: #17583E;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.login__logo-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.login__logo-bar {
  width: 56rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #7DB79A;
}

.login__name {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.login__slogan {
  color: #6E7D91;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.login__card {
  padding: 36rpx 32rpx;
}

.login__button {
  margin-top: 36rpx;
}

.login__error {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #FBE6E5;
}

.login__error-text {
  color: #B32B26;
  font-size: 26rpx;
  line-height: 1.55;
}

.login__retry {
  display: inline-flex;
  margin-top: 20rpx;
  background: #FFFFFF;
}

.login__dev {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E9E1D3;
}

.login__foot {
  margin-top: auto;
  text-align: center;
  padding-top: 48rpx;
}

/* The 「或」 between the two doors. */
.login__split {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 36rpx 0 24rpx;
  color: #9AA7B4;
  font-size: 24rpx;
}

.login__split::before,
.login__split::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #E9E1D3;
}

/*
 * Four pills do not fit one 375pt row (the bind page's original three did), so this set wraps.
 * Widths are in rpx and the padding is smaller than the bind page's for the same reason.
 */
.login__card .roles {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.login__card .role {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E9E1D3;
  background: #FFFFFF;
  color: #6E7D91;
  font-size: 24rpx;
}

.login__card .role--on {
  border-color: #17583E;
  background: #EAF3EE;
  color: #17583E;
}

/* The second card needs its own bottom margin: it is no longer the last element. */
.login__card .field {
  margin-top: 28rpx;
}
