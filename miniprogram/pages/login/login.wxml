<view class="page login">
  <view class="login__brand">
    <view class="login__logo">
      <view class="login__logo-dot"></view>
      <view class="login__logo-bar"></view>
    </view>
    <view class="login__name">Think-Class</view>
    <view class="login__slogan">班级成长助手</view>
  </view>

  <view class="card login__card">
    <view class="card__title">用微信登录</view>
    <view class="card__sub">第一次使用，需要用老师发的账号和密码绑定一次微信；以后打开就能直接进入。</view>

    <view class="btn btn--primary btn--block login__button {{busy ? 'btn--disabled' : ''}}" bindtap="onWechatLogin">
      {{busy ? '正在登录…' : '微信一键登录'}}
    </view>

    <view class="login__error" wx:if="{{error}}">
      <view class="login__error-text">{{error}}</view>
      <view class="btn btn--sm btn--ghost login__retry" bindtap="onRetry">再试一次</view>
    </view>

    <view class="login__dev" wx:if="{{configurationHint}}">
      <view class="tiny">如果是刚部署的服务端，请检查环境变量 WECHAT_APPID / WECHAT_SECRET 是否已设置。本地联调可以在服务端设置 WECHAT_ALLOW_DEV_LOGIN=1，并在 miniprogram/config/index.ts 里填写 DEV_LOGIN_OPENID 后重试。</view>
    </view>
  </view>

  <view class="login__split">或</view>

  <view class="card login__card">
    <view class="card__title">用账号密码登录</view>
    <view class="card__sub">首次使用会把这个微信绑定到你的账号，之后就能用上面的「微信一键登录」直接进入。</view>

    <view class="field">
      <view class="field__label">我是</view>
      <view class="roles">
        <view
          class="role {{accountRole === item.value ? 'role--on' : ''}}"
          wx:for="{{roles}}"
          wx:key="value"
          data-role="{{item.value}}"
          bindtap="onAccountRoleTap"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field__label">账号</view>
      <input
        class="field__input"
        type="text"
        value="{{accountUsername}}"
        placeholder="老师发给你的账号"
        placeholder-class="field__placeholder"
        bindinput="onAccountUsernameInput"
      />
    </view>

    <view class="field field--last">
      <view class="field__label">密码</view>
      <input
        class="field__input"
        password
        value="{{accountPassword}}"
        placeholder="初始密码可以问老师"
        placeholder-class="field__placeholder"
        bindinput="onAccountPasswordInput"
      />
    </view>

    <view class="btn btn--primary btn--block login__button {{busy ? 'btn--disabled' : ''}}" bindtap="onAccountLogin">
      {{busy ? '正在登录…' : '登录并绑定'}}
    </view>

    <view class="login__error" wx:if="{{accountError}}">
      <view class="login__error-text">{{accountError}}</view>
    </view>
  </view>

  <view class="login__foot">
    <view class="tiny">登录遇到问题？请联系你的老师重置账号密码。</view>
  </view>
</view>
