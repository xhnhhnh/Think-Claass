/*
 * 管理. Local field/role styles on purpose: those classes live in the page they belong to
 * (`pages/bind/bind.wxss`) rather than in `app.wxss`, and a page-scoped copy is cheaper than
 * promoting them to the global sheet for one screen.
 */

.manage {
  padding: 32rpx 40rpx 60rpx;
}

.manage__head {
  padding: 8rpx 0 28rpx;
}

.manage__error {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #FBE6E5;
}

.manage__error-text {
  color: #B32B26;
  font-size: 26rpx;
  line-height: 1.55;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.field--last {
  border-bottom: none;
}

.field__label {
  font-size: 25rpx;
  color: #6E7D91;
  margin-bottom: 10rpx;
}

.field__input {
  width: 100%;
  height: 64rpx;
  font-size: 32rpx;
  color: #0F1729;
}

.field__placeholder {
  color: #B3ADA0;
  font-size: 28rpx;
}

/* Two options here, so they can share the row evenly. */
.roles {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.role {
  flex: 0 0 auto;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E9E1D3;
  background: #FBFAF6;
  font-size: 28rpx;
  color: #6E7D91;
}

.role--on {
  border-color: #17583E;
  background: #E4F0E9;
  color: #17583E;
  font-weight: 600;
}
