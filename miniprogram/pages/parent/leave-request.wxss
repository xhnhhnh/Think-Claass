.error-card {
  border-left: 8rpx solid #DE3B35;
}

/* ------------------------------------------------------------------ form */

/* The form is the page's one write, so it carries the brand rail rather than a plain card. */
.form {
  border-left: 8rpx solid #17583E;
}

.field-row {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F1EFE7;
}

.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.field--half {
  flex: 1;
}

.field--last {
  border-bottom: none;
}

.field__label {
  font-size: 24rpx;
  color: #6E7D91;
  margin-bottom: 8rpx;
}

.field__picker {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 30rpx;
  color: #0F1729;
}

.field__textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 29rpx;
  line-height: 1.6;
}

.placeholder {
  color: #B3ADA0;
  font-size: 27rpx;
}

/* ------------------------------------------------------------------ record */

.leave__range {
  font-size: 31rpx;
  font-weight: 600;
}

.leave__reason {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #404F64;
  line-height: 1.6;
}

.leave__reply {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FBFAF6;
  border-left: 6rpx solid #1C5C87;
}

.leave__reply-label {
  font-size: 24rpx;
  color: #6E7D91;
  margin-bottom: 4rpx;
}

.leave__reply-text {
  font-size: 27rpx;
  color: #0F1729;
  line-height: 1.6;
}
