/*
 * 家庭时光. The field styles are the sibling 请假假条 page's, copied rather than shared: WXSS has no
 * cross-page import and `app.wxss` is deliberately the small shared layer (see the parent dashboard's
 * note for the same decision).
 */

.error-card {
  border-left: 8rpx solid #DE3B35;
}

/* ------------------------------------------------------------------ form */

/* The form is the page's one write, so it carries the brand rail rather than a plain card. */
.form {
  border-left: 8rpx solid #17583E;
}

.fields {
  margin-top: 24rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F1EFE7;
}

.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1EFE7;
}

.field--last {
  border-bottom: none;
}

.field__label {
  font-size: 24rpx;
  color: #6E7D91;
  margin-bottom: 8rpx;
}

.field__input {
  height: 64rpx;
  font-size: 30rpx;
}

.placeholder {
  color: #B3ADA0;
  font-size: 27rpx;
}

/* ------------------------------------------------------------------ 约定 */

.task__title {
  font-size: 31rpx;
  font-weight: 600;
}

/* The reward is the number a child keeps an eye on, so it is not plain body text. */
.task__points {
  font-size: 26rpx;
  font-weight: 600;
  color: #A85A08;
}
