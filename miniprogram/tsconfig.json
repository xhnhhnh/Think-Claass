{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2018"],
    "types": [],
    "typeRoots": [],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": false,
    "baseUrl": ".",
    "pretty": true
  },
  "include": ["typings/**/*.d.ts", "config/**/*.ts", "utils/**/*.ts", "services/**/*.ts", "components/**/*.ts", "custom-tab-bar/**/*.ts", "pages/**/*.ts", "app.ts"],
  "exclude": ["node_modules", "miniprogram_npm"]
}
