# Think-Class 环境变量模板
#
# 用法：`cp .env.example .env` 之后按注释填写。应用启动时由 `api/app.ts` 里的
# `dotenv.config()` 读取工作目录下的 `.env`；**已存在的环境变量优先于 .env**
# （dotenv 不覆盖已有值），所以容器/云托管里用平台环境变量注入是安全的。
#
# 这个文件里没有任何真实密钥，也不要有：它是要提交进仓库的。
# 真实的 `.env` 已被 .gitignore 忽略，且含 ENCRYPTION_KEY 与超管密码 —— 记得单独备份。
#
# 变量清单与 README.md 的“Configuration”表一致；表里没有的（本分支新增项、平台项、
# 插件项）在下面单独标注了来源。

# ---------------------------------------------------------------------------
# 必填：首次启动创建超管账号
# ---------------------------------------------------------------------------
# 首次启动时，只用这两个变量创建 superadmin 行；没有默认账号也没有默认密码，
# 两者缺一个就拒绝启动（api/db.ts）。数据库里已经有 superadmin 行时，
# 只要这两个变量**都**设置了，每次启动都会用它覆盖账号与密码 —— 这就是改密码的方式。
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 必填：静态加密密钥（学生姓名）
# ---------------------------------------------------------------------------
# 恰好 32 字节（`aes-256-cbc` 的密钥长度，api/db.ts 会按字节校验）。
# `install.sh` 写入的是 `randomBytes(16).toString('hex')` = 32 个十六进制字符 = 32 字节。
# 生成一次，之后**永远不要重新生成**：
#   node -e "process.stdout.write(require('node:crypto').randomBytes(16).toString('hex'))"
#
# 丢失或更换这个值的后果不是“重新登录”，而是已加密的学生姓名永久不可读
# （解密失败时 `decrypt()` 会把密文原样返回，页面上出现 iv:cipher 形式的乱码）。
# 需要换密钥时先做重加密：node scripts/rotate-encryption-key.mjs --help
# 留空 = 没有密钥：加密/解密时直接抛错（这是刻意的 fail-closed，guardrail G18）。
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 数据与静态资源路径
# ---------------------------------------------------------------------------
# 运行时的数据库开关。相对路径按工作目录解析（packages/kernel/src/config/loadConfig.ts、
# api/db.ts 用的是同一条规则），所以容器里的绝对路径最省事：/data/database.sqlite
# DATABASE_FILE=database.sqlite

# Prisma CLI 用的连接串，**不是**运行时开关：应用把 DATABASE_FILE 解析出的同一个文件
# 显式传给 Prisma（api/prismaClient.ts），两者因此不会分叉。
# `install.sh` / `update.ps1` 会在缺失时补上这一行。
DATABASE_URL="file:./database.sqlite"

# 数据库文件放在网络/共享存储（例如微信云托管的 CFS 挂载卷）上时置 1：
# SQLite 的 WAL 依赖共享内存与文件锁，在网络文件系统上会静默损坏或报错。
# 本分支新增 —— 在它落地之前源码里读不到这个变量，所以请按
# docs/wechat/10-deploy-cloudrun.md 第 6.2 节验证 `PRAGMA journal_mode`：
# 期望 delete；仍是 wal 就不要把数据库放在网络挂载上。
# DATABASE_SKIP_WAL=1

# 上传文件目录。注意默认组合（KERNEL_ENABLED 未设）里，上传的**写入**与**静态服务**
# 都固定用 `<工作目录>/uploads`，不读这个变量（api/app.ts:86、plugins/homework、
# plugins/learning 都用 process.cwd()）。设成别的路径的唯一效果，是等哪天切到内核组合时
# 静态服务按它走，而插件写文件仍按 cwd —— 两者不一致就会出现"照片写进去了但访问 404"。
# 容器里要持久化照片，请把挂载卷挂到 `<工作目录>/uploads`，见 deploy/Dockerfile 的符号链接说明。
# UPLOADS_DIR=uploads

# 前端构建产物目录（默认 dist，相对 THINK_CLASS_ROOT 解析）
# STATIC_DIR=dist

# 部署根目录。默认是 process.cwd()。
# 不要把它指到与工作目录不同的地方：DATABASE_FILE 里的相对路径、STATIC_DIR、PLUGIN_DIRS
# 都按它解析，而上传目录按 cwd 解析 —— 两者分开就会出现“照片写进去了但访问 404”。
# THINK_CLASS_ROOT=/class

# ---------------------------------------------------------------------------
# 服务与后台
# ---------------------------------------------------------------------------
# API 端口。install.sh 默认 3001，端口被占用时可能自动换端口 —— 以 .env 里的实际值为准。
# PORT=3001

# 超管后台路径。运行时配置：服务端注入 window.__TC_CONFIG__.adminPath，前端从那里读。
# 改了只需要重启服务，不需要重新构建（早期版本靠 sed 重写 dist/**，那个机制已经删掉了）。
# 两个变量同时存在时 VITE_ADMIN_PATH 优先。
# ADMIN_PATH=/beiadmin
# VITE_ADMIN_PATH=/beiadmin

# 生产模式。`install.sh` / `update.sh` **不会**设置它，PM2 起的进程默认是 development
# （kernel 的 env 字段、Express 的默认错误处理都会跟着变）。
# 自建服务器建议在 .env 里显式打开，然后 `pm2 restart think-class --update-env`。
# 安全上也不是可选项：plugins/wechat 拒用开发登录（devOpenid）的第一道闸就是这个值。
# NODE_ENV=production

# 日志级别：debug | info | warn | error | silent（默认 info；NODE_ENV=test 下为 silent）
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 组合开关（默认值就是部署值，一般不用改）
# ---------------------------------------------------------------------------
# 不设 = 传统 Nest 组合（默认，也是回滚目标）；设 1 = 以内核为组合根。
# KERNEL_ENABLED=1

# 插件宿主。默认 true，而且是**承重**的：所有业务域都是插件，api/app.module.ts 的
# imports 是空的 —— 关掉它，传统组合就没有任何业务路由。
# 设 0 只在 KERNEL_ENABLED=1（纯内核）时才成立；传统组合 + 0 会在启动时被
# assertUsableComposition() 直接拒绝。
# PLUGINS_ENABLED=1

# 插件扫描目录，逗号分隔，按顺序生效（默认 plugins,plugins-ext）。
# 容器里如果目录少了 plugins/，启动会以 “activated 0 plugins” 失败，而不是静默 404。
# PLUGIN_DIRS=plugins,plugins-ext

# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
# 会话有效期，毫秒。默认 7 天（604800000）。
# SESSION_TTL_MS=604800000

# 接受 x-user-role / x-user-id 作为身份。默认 false。
# 这两个头完全由客户端提供、无法验证，置 1 等于任何人都能冒充任何人（包括 superadmin），
# 所有按端点的鉴权同时失效。只在确有旧客户端需要过渡时打开。
# ALLOW_LEGACY_HEADER_AUTH=0

# ---------------------------------------------------------------------------
# 微信小程序后端（plugins/wechat）
# ---------------------------------------------------------------------------
# 用于 /api/wechat/login 的 code2session 交换。AppSecret 只能留在服务端：
# 放进小程序包就等于公开，而且官方明确 api.weixin.qq.com 不允许被配置成小程序的服务器域名。
# 两个变量都由插件在**每次登录时**读取，不是启动时校验，所以没配也不影响应用启动。
# 两个都没配（或其中一个为空）时 /api/wechat/login 返回 503
# 「微信小程序未配置：请设置 WECHAT_APPID / WECHAT_SECRET」——没有内置默认值，也不该有。
WECHAT_APPID=
WECHAT_SECRET=

# 开发登录旁路：请求体里带 devOpenid 时跳过 code2session，直接用该 openid 登录。
# 两道闸：NODE_ENV=production 时一律 403「生产环境不允许使用开发登录」；
# 否则还需要这里设为 1，否则 403「开发登录未启用」。每次使用都会写一条 warn 日志。
# 生产环境务必保持注释状态 —— 而且注意 install.sh / update.sh 都不设 NODE_ENV，
# 所以第一道闸默认是开的，必须自己把 NODE_ENV=production 写上（见上面的说明）。
# WECHAT_ALLOW_DEV_LOGIN=1

# ---------------------------------------------------------------------------
# 更新器（超管后台一键更新；仅 Linux）
# ---------------------------------------------------------------------------
# release 来源。默认就是本仓库，只有换镜像/私有分发时才需要改。
# THINK_CLASS_RELEASE_REPO=xhnhhnh/Think-Claass
# THINK_CLASS_RELEASE_ASSET=think-class-release.zip

# GitHub API 令牌。设了之后 scripts/deploy-common.sh 与后台更新器会用认证请求取 release，
# 避免匿名调用被打限流。只需要 public repo 的读权限。
# GITHUB_TOKEN=

# 更新日志与状态文件的落点。由后台更新器在 spawn update.sh 时注入；
# 手工执行 `bash update.sh` 时保持默认即可（logs/update.log、logs/update-status.json）。
# UPDATE_LOG_DIR=./logs
# UPDATE_LOG_FILE=./logs/update.log
# UPDATE_STATUS_FILE=./logs/update-status.json

# ---------------------------------------------------------------------------
# 构建期变量（改了要重新构建前端，不是重启）
# ---------------------------------------------------------------------------
# 前端默认同源调用 /api，同源部署什么都不用设。
# 只有前后端不同源时才需要，且**不要在 HTTPS 站点上指向 http://**（会被浏览器拦）。
# install.sh 故意不再写它：写一个 http:// 的绝对地址只会帮倒忙。
# VITE_API_BASE_URL=https://example.com

# 当前版本号，由 install.sh / update.sh 写入，后台更新器用它判断有没有新版本。
# 一般不用手工填。
# CURRENT_VERSION=v2.1.1

# ---------------------------------------------------------------------------
# 运行环境杂项
# ---------------------------------------------------------------------------
# 容器默认 UTC。页面上的时间比北京时间少 8 小时时设这个（Node 按 TZ 解析本地时间）。
# TZ=Asia/Shanghai
